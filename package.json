{
  "name": "degravity-studio",
  "version": "0.1.0",
  "private": true,
  "description": "DeGravity Studio — a native agentic development environment",
  "author": "DeGravity Studio contributors",
  "license": "MIT",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1",
    "build:ui": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "build": "npm run build:engine && npm run build:ui",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:engine": "cargo test --workspace",
    "test:smoke": "node scripts/smoke-engine.mjs",
    "test:ui": "electron scripts/smoke-ui.cjs",
    "check": "npm run typecheck && npm test && npm run test:engine",
    "package": "npm run build && electron-builder --publish never",
    "package:ci": "electron-builder --publish never",
    "start": "electron ."
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-dialog": "1.1.6",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.4.7",
    "lucide-react": "0.468.0",
    "monaco-editor": "0.52.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.2",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/node": "22.13.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.21",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "0.25.0",
    "postcss": "8.5.3",
    "prettier": "3.5.3",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
